# Copy this file to .env and fill in what you have. Everything is optional:
# with no values the app runs on the local file database with offline AI.

# --- Server ---
PORT=4000
SESSION_SECRET=change-me-to-any-long-random-text

# --- Database ---
# local  = JSON files in ./data (default, zero setup)
# sheets = Google Sheets (needs the two values below)
DB_DRIVER=local
DATA_DIR=./data
GOOGLE_SHEET_ID=
# Path to the service-account JSON key you downloaded from Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# --- AI (Piku and AI suggestions) ---
# Your Google AI Studio / Gemini API key. Never commit it.
GEMINI_API_KEY=
# Models tried in order until one answers
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
